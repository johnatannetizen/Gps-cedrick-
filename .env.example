# ==============================================================
# CEDRICK GPS — CONFIGURACIÓN MAESTRA 100% GRATUITA Y OPEN SOURCE
# Todas las APIs y servicios operan a costo $0 USD sin requerir tarjetas
# ==============================================================

# --- AI STUDIO RUNTIME ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- 1 & 2. SERVIDOR CENTRAL TRACCAR (100% GRATUITO - OPEN SOURCE APACHE 2.0) ---
# Traccar Server auto-hospedado en VPS o instancia local sin costo de licencias
TRACCAR_SERVER_URL="http://localhost:3000"
TRACCAR_USER_EMAIL="admin@cedrickgps.com"
TRACCAR_USER_PASSWORD="CedrickSecure2026!"
TRACCAR_API_TOKEN=""

# --- 3. PROTOCOLO DE TRANSMISIÓN OSMAND (100% GRATUITO) ---
# Estándar libre de telemetría GPS para smartphones y rastreadores vehiculares
OSMAND_PORT="5055"
OSMAND_INGEST_PATH="/api/positions"

# --- 4 & 5. MAPAS Y TESELAS VECTORIALES (OPENSTREETMAP & MAPLIBRE GL - 100% GRATIS) ---
# Proveedor mundial libre OpenStreetMap y motor MapLibre GL sin cobro ni tokens
MAP_TILE_PROVIDER_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_DARK_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"

# --- 6. IMÁGENES SATELITALES EN ALTA RESOLUCIÓN (100% GRATIS - SIN TOKEN) ---
# Esri World Imagery (Cero costo, no requiere tarjeta de crédito ni registro)
MAP_SATELLITE_PROVIDER_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
MAP_SATELLITE_ATTRIBUTION="Tiles &copy; Esri, Maxar, Earthstar Geographics"

# --- 7. GEOCODIFICACIÓN INVERSA (100% GRATIS - SIN TARJETA) ---
# Nominatim OpenStreetMap (Gratuito mundial) o Photon Komoot (Gratis sin registro)
GEOCODER_PROVIDER="nominatim"
GEOCODER_URL="https://nominatim.openstreetmap.org/reverse"
GEOCODER_PHOTON_URL="https://photon.komoot.io/reverse"

# --- 8. NOTIFICACIONES PUSH ANDROID & WEB (100% GRATIS) ---
# Google Firebase Capa Gratuita Spark ($0 USD para siempre en mensajería push)
# o servidor de notificaciones libre ntfy.sh (Open Source)
FIREBASE_PROJECT_ID="cedrick-gps-free"
NTFY_TOPIC="cedrick_gps_alerts"
NTFY_SERVER_URL="https://ntfy.sh"

# --- 9. NOTIFICACIONES IOS GRATUITAS (SIN PAGAR $99 USD/AÑO A APPLE) ---
# Opción 1: Web Push PWA (Soportado nativamente en iOS 16.4+ a costo $0)
# Opción 2: App gratuita ntfy en iOS App Store (Alertas push instantáneas sin cuenta de desarrollador)
# Opción 3: Bot oficial de Telegram para alertas de pánico y geocercas
IOS_FREE_PUSH_MODE="pwa_webpush"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- 10. WEB PUSH VAPID (100% GRATUITO - ESTÁNDAR W3C) ---
# Par de llaves criptográficas VAPID para notificaciones en navegador sin intermediarios de pago
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U"
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alertas@cedrickgps.com"

# --- 11. SENSORES DE GEOLOCALIZACIÓN NATIVOS (100% GRATIS) ---
# Sensor GPS físico integrado en el terminal vía HTML5 Geolocation y Flutter CoreLocation
GPS_HIGH_ACCURACY="true"
GPS_OFFLINE_BUFFER_ENABLED="true"

# --- 12. SERVICIO DE CORREO SMTP GRATUITO ---
# Proveedores con capa gratuita permanente sin tarjeta:
# - Brevo (300 correos gratis/día - $0 USD)
# - Gmail SMTP (500 correos gratis/día con contraseña de aplicación)
# - Resend (3,000 correos gratis/mes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notificaciones.cedrickgps@gmail.com"
SMTP_PASS=""
SMTP_FROM="CEDRICK GPS <notificaciones.cedrickgps@gmail.com>"

# --- 13. MOTOR DE ENRUTAMIENTO Y DISTANCIAS (100% GRATIS - OSRM) ---
# Open Source Routing Machine público sin cuotas ni registro
ROUTING_PROVIDER="osrm"
ROUTING_OSRM_URL="https://router.project-osrm.org"
